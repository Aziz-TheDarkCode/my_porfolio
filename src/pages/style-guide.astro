---
import Layout from '../layouts/Layout.astro';

const palette = [
  { token: 'paper', hex: '#fbfaf8', role: 'Page background' },
  { token: 'ink', hex: '#1b1a17', role: 'Body text, headings' },
  { token: 'ink-soft', hex: '#6b6a64', role: 'Secondary text, meta' },
  { token: 'ink-faint', hex: '#a3a29b', role: 'Borders, separators, bullets' },
  { token: 'brand', hex: '#d95b24', role: 'Links, focus, selection' },
];
---

<Layout
  title="Style guide"
  description="Colour, type and component reference for this portfolio."
  noindex
>
  <main class="mx-auto max-w-2xl px-6 py-16 sm:py-24">
    <header>
      <p class="section-label">Design system</p>
      <h1 class="mt-3 text-2xl font-medium tracking-tight sm:text-3xl">
        Style guide
      </h1>
      <p class="mt-3 text-ink-soft">
        Tokens and components used across the site. All colours come from the
        <code class="text-sm">@theme</code> block in
        <code class="text-sm">src/styles/global.css</code>.
      </p>
    </header>

    <section class="mt-12 border-t border-ink/10 pt-10">
      <h2 class="section-label">Colour</h2>

      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          palette.map((color) => (
            <div class="overflow-hidden rounded-lg border border-ink/10">
              <div
                class="h-20 w-full"
                style={`background-color: var(--color-${color.token});`}
              />
              <div class="flex items-baseline justify-between gap-4 px-4 py-3">
                <div>
                  <p class="text-sm font-medium">--color-{color.token}</p>
                  <p class="text-sm text-ink-soft">{color.role}</p>
                </div>
                <code class="shrink-0 text-sm text-ink-soft">{color.hex}</code>
              </div>
            </div>
          ))
        }
      </div>

      <p class="mt-4 text-sm text-ink-soft">
        Selection uses <span class="bg-brand px-1 text-paper">brand on paper</span>.
        Focus rings use a 2px <code class="text-sm">brand</code> outline.
      </p>
    </section>

    <section class="mt-12 border-t border-ink/10 pt-10">
      <h2 class="section-label">Typography</h2>

      <div class="mt-6 space-y-6">
        <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-ink/10 pb-4">
          <p class="font-display text-3xl font-bold tracking-tight">
            Pixelify Sans
          </p>
          <span class="section-hint mt-0">Display · 400–700</span>
        </div>

        <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-ink/10 pb-4">
          <p class="text-2xl font-medium tracking-tight">
            Afacad — headings, 500
          </p>
          <span class="section-hint mt-0">--font-sans</span>
        </div>

        <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-ink/10 pb-4">
          <p class="text-base">
            Afacad — body copy at 400, the default reading size.
          </p>
          <span class="section-hint mt-0">--font-sans</span>
        </div>

        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <p class="text-sm text-ink-soft">
            Afacad — small text at 400 for meta and captions.
          </p>
          <span class="section-hint mt-0">ink-soft</span>
        </div>
      </div>
    </section>

    <section class="mt-12 border-t border-ink/10 pt-10">
      <h2 class="section-label">Inline elements</h2>

      <div class="prose mt-6 max-w-none">
        <p>
          Body text with an <a href="/">inline link</a>, some
          <strong>bold weight</strong>, and a bit of
          <code>inline code</code>. Links are underlined in brand, never in ink
          alone.
        </p>
      </div>
    </section>

    <section class="mt-12 border-t border-ink/10 pt-10">
      <h2 class="section-label">Components</h2>

      <div class="mt-6 space-y-8">
        <div>
          <p class="section-hint mt-0">Section label</p>
          <p class="section-label mt-4">Selected work</p>
          <p class="section-hint">Optional hint sitting under the label.</p>
        </div>

        <div class="rounded-lg border border-ink/10 p-5">
          <div class="flex items-center gap-3">
            <span
              aria-hidden="true"
              class="h-2 w-2 shrink-0 rounded-full bg-brand"
            ></span>
            <p class="text-sm font-medium">Accent dot</p>
          </div>
          <p class="mt-2 text-sm text-ink-soft">
            A single brand marker, as used on the 404 page and section anchors.
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>
