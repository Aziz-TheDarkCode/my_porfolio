---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const site = Astro.site ?? new URL('https://abdouaziz.dev');
const url = new URL(`/blog/${post.id}/`, site).href;
const modifiedTime = post.data.updatedDate ?? post.data.pubDate;
const ogImage = post.data.image ?? '/og.jpg';

const jsonLd = {
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  url,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  datePublished: post.data.pubDate.toISOString(),
  dateModified: modifiedTime.toISOString(),
  inLanguage: post.data.lang,
  keywords: post.data.tags.join(', '),
  author: { '@id': new URL('/#person', site).href },
  image: new URL(ogImage, site).href,
};
---

<Layout
  title={`${post.data.title} — Abdou A. Ndiaye`}
  description={post.data.description}
  type="article"
  lang={post.data.lang}
  publishedTime={post.data.pubDate}
  modifiedTime={modifiedTime}
  tags={post.data.tags}
  jsonLd={jsonLd}
  image={ogImage}
  imageAlt={post.data.imageAlt}
>
  <main class="mx-auto max-w-2xl px-6 py-16 sm:py-24">
    <a href="/blog" class="text-sm text-ink-soft hover:text-ink">← Back to blog</a>
    <header class="mt-6 border-b border-ink/10 pb-8">
      <h1 class="text-2xl font-medium tracking-tight sm:text-3xl">{post.data.title}</h1>
      <time
        class="mt-3 block text-sm text-ink-soft"
        datetime={post.data.pubDate.toISOString()}
      >
        {post.data.pubDate.toLocaleDateString(post.data.lang === 'fr' ? 'fr-FR' : 'en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </time>
    </header>

    {
      post.data.image && (
        <figure class="mt-8">
          <img
            src={post.data.image}
            alt={post.data.imageAlt ?? post.data.title}
            width="1200"
            height="630"
            loading="eager"
            decoding="async"
            class="w-full rounded-lg border border-ink/10"
          />
          {post.data.imageHint && (
            <figcaption class="mt-2 text-xs text-ink-soft">
              {post.data.imageHint}
            </figcaption>
          )}
        </figure>
      )
    }

    <article class="prose mt-8 max-w-none">
      <Content />
    </article>
  </main>
</Layout>
