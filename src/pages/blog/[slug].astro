---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} description={post.data.description}>
  <main class="mx-auto max-w-2xl px-6 py-16 sm:py-24">
    <a href="/blog" class="text-sm text-ink-soft hover:text-ink">← Back to blog</a>
    <header class="mt-6 border-b border-ink/10 pb-8">
      <h1 class="text-2xl font-medium tracking-tight sm:text-3xl">{post.data.title}</h1>
      <time
        class="mt-3 block text-sm text-ink-soft"
        datetime={post.data.pubDate.toISOString()}
      >
        {post.data.pubDate.toLocaleDateString(undefined, {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </time>
    </header>

    <article class="prose mt-8 max-w-none">
      <Content />
    </article>
  </main>
</Layout>
